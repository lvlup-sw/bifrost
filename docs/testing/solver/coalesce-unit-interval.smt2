(set-logic QF_BV)
(declare-const last (_ BitVec 64))
(declare-const now (_ BitVec 64))
(define-fun interval () (_ BitVec 64) (_ bv1 64))
(assert (bvsge last (_ bv0 64)))
(assert (bvsle now (_ bv3155378975999999999 64)))
(assert (bvsgt interval (_ bv0 64)))
(assert (bvsge now last))
(assert (bvsge (bvsub now last) interval))
(define-fun count () (_ BitVec 64) (bvsdiv (bvsub now last) interval))
(define-fun latest () (_ BitVec 64) (bvadd last (bvmul count interval)))
(push)
(assert (or (bvsgt latest now) (bvslt latest last) (bvsge (bvsub now latest) interval)))
(check-sat)
(pop)
(assert (= last (_ bv0 64)))
(assert (= interval (_ bv1 64)))
(assert (= now (_ bv101 64)))
(define-fun capped () (_ BitVec 64) (ite (bvslt count (_ bv100 64)) count (_ bv100 64)))
(define-fun old-result () (_ BitVec 64) (bvadd last (bvmul capped interval)))
(assert (distinct latest old-result))
(check-sat)
(get-value (last now interval latest old-result))
