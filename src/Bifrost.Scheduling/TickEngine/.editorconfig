# =============================================================================
# Bifrost.Scheduling/TickEngine — local analyzer overrides
# =============================================================================
# RS0030 (BannedApiAnalyzers): suppress the Task.Delay(TimeSpan) ban for
# ScheduleTickLoop's WaitForIdleAsync and WaitForFaultedAsync barrier methods.
#
# These two internal test-harness primitives use Task.Delay(timeout) as a
# real-wall-clock guard to prevent test hangs — NOT as a scheduled tick.
# Using TimeProvider here would be incorrect: the caller already controls fake
# time via TimeProvider.Advance, and a fake-clock deadline would never fire.
#
# TRACKED DEFECT: replace Task.Delay(timeout) with a CancellationToken wired to
# a real-wall-clock source (e.g. CancellationTokenSource(timeout)) so the pattern
# is explicit and discoverable. Until then, RS0030 is suppressed per-directory.
# =============================================================================

[ScheduleTickLoop.cs]
dotnet_diagnostic.RS0030.severity = suggestion
