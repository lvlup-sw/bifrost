<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>LevelUp.Bifrost.Concurrency</PackageId>
    <RootNamespace>Bifrost.Concurrency</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <!-- Cache-line padding structs require unsafe blocks -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NativeAOT compatibility -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Generate documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Concurrency primitives for Bifrost: a MultiQueue ConcurrentPriorityQueue (lock-striped sub-queue heaps, two-choice relaxed dequeue with a quantified rank-error contract) and a lock-based exact-ordering LockingPriorityQueue.</Description>
    <PackageTags>Concurrency;PriorityQueue;ConcurrentPriorityQueue;MultiQueue;ThreadSafe</PackageTags>
  </PropertyGroup>

  <!--
    Test-only observability counters (occupancy-write / routing-hit / scan-entry, DR-2/DR-3) are
    compiled in only behind BIFROST_TEST_HOOKS, so the InternalsVisibleTo test suite can read them
    in every normal build — Debug AND Release (the concurrency suite runs in Release, see ci.yml).
    The publish workflow builds with BifrostTestHooks=false, stripping the instrumentation from the
    shipped NuGet binary (the same artifact that the no-build `dotnet pack` step packages). The
    counter fields and their ...ForTest getters are intentionally left ungated so the test project
    still compiles against the stripped library in the publish build's solution-wide compile.
  -->
  <PropertyGroup>
    <BifrostTestHooks Condition="'$(BifrostTestHooks)' == ''">true</BifrostTestHooks>
    <DefineConstants Condition="'$(BifrostTestHooks)' == 'true'">$(DefineConstants);BIFROST_TEST_HOOKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bifrost.Tests.Concurrency" />
    <InternalsVisibleTo Include="Bifrost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Banned-API gate (RS0030): reflection/runtime-codegen regressions fail the build (DR-9) -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
