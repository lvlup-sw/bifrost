<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TargetFramework, Nullable, ImplicitUsings, LangVersion, IsAotCompatible
         are all inherited from samples/Directory.Build.props → src/Directory.Build.props. -->
    <RootNamespace>Bifrost.Keyed.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <!-- NativeAOT: only active during `dotnet publish`, not `dotnet build`.
         Publish with `dotnet publish -c Release /p:PublishAot=true`. A regular
         `dotnet build` still compiles and validates trim-analyzer warnings
         without requiring the native toolchain locally. -->
    <!-- AOT/trim safety: IsAotCompatible=true is inherited from Directory.Build.props;
         trim warnings flow into warnings-as-errors via TreatWarningsAsErrors. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Silence the xml-doc warning (no doc file for a console host) -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>AOT smoke test for Bifrost keyed dispatch — verifies WithKeyedDispatch, WithScopedHandler, and WithHandlerResilience publish warning-clean under NativeAOT and keep per-key order and both admission limits.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the projects by relative path (sample lives in samples/,
         solution is in src/ — paths are relative to this csproj). -->
    <ProjectReference Include="..\..\src\Bifrost\Bifrost.csproj" />
    <ProjectReference Include="..\..\src\Bifrost.Resilience\Bifrost.Resilience.csproj" />
  </ItemGroup>

</Project>
