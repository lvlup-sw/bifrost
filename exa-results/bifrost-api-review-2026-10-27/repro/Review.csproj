<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(QueueSources)/*.cs" />
  </ItemGroup>
  <Target Name="RequireBaseline" BeforeTargets="CoreCompile">
    <Error Condition="'$(QueueSources)' == ''" Text="Set QueueSources to the original 6800ae0 Bifrost.Concurrency directory; this is a historical defect reproduction." />
  </Target>
</Project>
