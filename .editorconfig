# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
indent_size = 4

# StyleCop rules - set to suggestion/none to avoid treating as errors
# These rules are stylistic preferences, not correctness issues

# Ordering rules
dotnet_diagnostic.SA1200.severity = suggestion
dotnet_diagnostic.SA1201.severity = suggestion
dotnet_diagnostic.SA1202.severity = suggestion
dotnet_diagnostic.SA1203.severity = suggestion
dotnet_diagnostic.SA1204.severity = suggestion

# Naming rules
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1310.severity = suggestion
dotnet_diagnostic.SA1311.severity = suggestion

# Maintainability rules
dotnet_diagnostic.SA1402.severity = suggestion
dotnet_diagnostic.SA1413.severity = suggestion
dotnet_diagnostic.SA1124.severity = suggestion

# Layout rules
dotnet_diagnostic.SA1500.severity = suggestion
